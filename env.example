# Where users reach the console.
PUBLIC_URL=https://admin.example.com

# --- Sign-in: configure one method or more (see README) --------------------------
# Passwords: email:hash entries from `ktms-admin hash-password you@example.com`,
# separated by spaces or newlines. Keep the single quotes: hashes contain "$" (with
# `docker run --env-file`, which takes values literally, drop them).
# ADMIN_USERS='you@example.com:$argon2id$v=19$m=19456,t=2,p=1$…'
# Or one entry per line in a file (a mounted secret):
# ADMIN_USERS_FILE=/run/secrets/admin-users

# OpenID Connect, Google by default: the redirect URI is PUBLIC_URL + /auth/callback.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://keycloak.example.com/realms/main
# OIDC_NAME=Keycloak
# More providers: OIDC_PROVIDERS=corp and OIDC_CORP_ISSUER, OIDC_CORP_CLIENT_ID, OIDC_CORP_CLIENT_SECRET.

# GitHub: the callback URL is PUBLIC_URL + /auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Or an access proxy at these addresses that sends the user's e-mail in AUTH_HEADER_EMAIL.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
# AUTH_HEADER_EMAIL=X-Forwarded-Email
# AUTH_HEADER_NAME=
# Cloudflare Access: team domain and the application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN=myteam
# CF_ACCESS_AUD=

# --- Who may sign in --------------------------------------------------------------
# Comma/space separated; "*" matches any run of characters, never across the @.
#   alice@example.com   *@example.com   *@*.example.org   (*@* admits everyone who can sign in)
ALLOWED_EMAILS=*@example.com
# Optional: these users get a read-only console.
VIEWER_EMAILS=
# Optional: team workspaces, email:team_id[:teamlead|member[:org_id]], comma/space separated.
TEAM_MEMBERSHIPS=
# 32+ random characters (openssl rand -base64 36). Without it sessions end on every restart.
SESSION_SECRET=
SESSION_TTL=12h

# --- Backends: configure either one, or both --------------------------------------
# KTMS gateway (gRPC). The key needs the admin scope.
KTMS_ADDR=ktms:9090
KTMS_ADMIN_KEY=
# Optional, Keystone 1.2+: a key with the admin:read scope for reads and viewers.
KTMS_READ_KEY=
KTMS_TLS=false
# light-tokenmeter (HTTP). With its auth on, a token with the read scope.
TOKENMETER_URL=http://light-tokenmeter:8080
TOKENMETER_TOKEN=

# --- Server -------------------------------------------------------------------
LISTEN_ADDR=:8080
LOG_LEVEL=info

# --- Only for examples/compose.yaml -----------------------------------------------
# DB_PASSWORD=change-me
# KTMS_ENCRYPTION_KEYS=1:<base64 of 32 random bytes>   # echo "1:$(head -c 32 /dev/urandom | base64)"
# BOOTSTRAP_ADMIN_KEY=<one-time key for minting the console's key>
# light-tokenmeter auth (optional): two random tokens, one for KTMS (write), one for
# the console (TOKENMETER_TOKEN above, read); light-tokenmeter gets only their hashes.
#   W=$(openssl rand -hex 32); R=$(openssl rand -hex 32)
#   h() { printf %s "$1" | openssl dgst -sha256 -r | cut -d' ' -f1; }
#   echo "USAGE_COLLECTOR_TOKEN=$W"; echo "TOKENMETER_TOKEN=$R"
#   echo "TOKENMETER_TOKENS=ktms:write:$(h $W),console:read:$(h $R)"
# USAGE_COLLECTOR_TOKEN=
# TOKENMETER_TOKENS=
